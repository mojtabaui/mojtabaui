generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  name      String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  licenses  SpotPlayerLicense[]
}

model Course {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  subtitle    String
  description String  @db.Text
  price       Int
  thumbnail   String?
  duration    String?
  lessons     Int     @default(0)
  level       Level   @default(BEGINNER)
  isPublished Boolean @default(false)
  spotplayerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id        String         @id @default(cuid())
  userId    String
  courseId  String
  amount    Int
  status    PurchaseStatus @default(PENDING)
  authority String?
  refId     String?
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([courseId])
}

model SpotPlayerLicense {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  licenseKey String    @unique
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// گواهینامه‌های صادرشده — منبع اولیه: فایل‌های اکسل در prisma/certs،
/// از ۱۴۰۵ به بعد از پنل مدیریت صادر می‌شن.
model Certificate {
  id          String    @id @default(cuid())
  code        String    @unique
  studentName String
  track       CertTrack
  year        String? // کوادکمپ (QC) سال نداره
  startDate   String    @default("")
  createdAt   DateTime  @default(now())

  @@index([code])
}

/// پیام‌های فرم تماس صفحه‌ی اصلی
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// شماره‌هایی که برای اطلاع از تخفیف‌ها ثبت شدن
model DiscountSubscriber {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// دانشجوهای دوره‌های آفلاین و پروژه‌ای که برداشتن.
/// فعلاً بدون حساب کاربری ثبت می‌شن (ایمیل‌ها هنوز نیست)؛ بعداً با
/// افزودن userId به User وصل می‌شن و خود دانشجو موضوعش رو وارد می‌کنه.
model StudentProject {
  id           String       @id @default(cuid())
  studentName  String
  track        ProjectTrack
  /// ماه ثبت‌نام به شکل «۱۴۰۵-۰۴» تا مرتب‌سازی و گروه‌بندی درست کار کنه
  intakeMonth  String
  /// موضوع پروژه — تا وقتی دانشجو انتخاب نکرده خالیه
  topic        String       @default("")
  /// لینک فایل کار، معمولاً فیگما. خودِ دانشجو توی فرم عمومی می‌ذارتش
  fileLink     String       @default("")
  /// شمارهٔ تسک‌هایی که منتور **بررسی‌شون کرده**.
  /// تیک یعنی بررسی شد، نه اینکه دانشجو تحویل داده.
  reviewedTasks Int[]       @default([])
  /// سابقه و آشنایی قبلی — از معرفی خودش توی گروه
  background   String?
  /// هدفش از دوره، برای اینکه منتور بدونه چه جور پروژه‌ای بهش بده
  goal         StudentGoal  @default(UNKNOWN)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([intakeMonth])
  @@index([track])
  @@index([goal])
}

enum ProjectTrack {
  UI
  UX
}

enum StudentGoal {
  UNKNOWN // هنوز نگفته
  LEARNING // یادگیری و ارتقای سطح
  EMPLOYMENT // استخدام
  FREELANCE // کار فریلنسری
  BOTH // هم استخدام هم فریلنس
}

enum CertTrack {
  UI
  UX
  QC // کوادکمپ
}

enum Role {
  USER
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PurchaseStatus {
  PENDING
  SUCCESS
  FAILED
}
