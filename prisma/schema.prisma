generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  name      String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  licenses  SpotPlayerLicense[]
}

model Course {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  subtitle    String
  description String  @db.Text
  price       Int
  thumbnail   String?
  duration    String?
  lessons     Int     @default(0)
  level       Level   @default(BEGINNER)
  isPublished Boolean @default(false)
  spotplayerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id        String         @id @default(cuid())
  userId    String
  courseId  String
  amount    Int
  status    PurchaseStatus @default(PENDING)
  authority String?
  refId     String?
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([courseId])
}

model SpotPlayerLicense {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  licenseKey String    @unique
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// لایسنس‌هایی که از پنل مدیریت دستی صادر می‌شن (فروش کارت‌به‌کارت).
/// خریدار لازم نیست روی سایت حساب داشته باشه، برای همین به User وصل نیست.
model SpotLicense {
  id        String   @id @default(cuid())
  spotId    String   @unique // _id لایسنس در پنل اسپات‌پلیر
  key       String
  url       String   @default("")
  name      String
  phone     String // متن واترمارک
  courseIds String[] // شناسه‌های اسپات‌پلیر
  devices   Int? // سهمیهٔ دستگاه؛ خالی یعنی پیش‌فرض پنل
  test      Boolean  @default(false)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// دانشجوهای دوره‌های بی‌نهایت (ویدیویی روی اسپات‌پلیر).
/// اسپات‌پلیر هیچ گزارشی از تماشا نمی‌ده، پس مدرس خودش برای هر هفته
/// دو تیک می‌زنه: ویدیوی اون هفته دیده شده، تسک اون هفته انجام شده.
/// عددها شمارهٔ هفته‌ان (۱ تا ۱۰) و هر آرایه فقط شمارهٔ هفته‌های تیک‌خورده رو نگه می‌داره.
model InfinityStudent {
  id         String   @id @default(cuid())
  name       String
  phone      String   @default("")
  /// slug دوره در mock-data: ui-infinity یا ux-infinity
  course     String
  videosDone Int[]    @default([])
  tasksDone  Int[]    @default([])
  note       String   @default("")
  /// شمارهٔ گروه تیمی پروژه (۱، ۲، …)؛ خالی یعنی هنوز گروهی نداره
  teamGroup  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([course])
}

/// گواهینامه‌های صادرشده — منبع اولیه: فایل‌های اکسل در prisma/certs،
/// از ۱۴۰۵ به بعد از پنل مدیریت صادر می‌شن.
model Certificate {
  id          String    @id @default(cuid())
  code        String    @unique
  studentName String
  track       CertTrack
  year        String? // کوادکمپ (QC) سال نداره
  startDate   String    @default("")
  createdAt   DateTime  @default(now())

  @@index([code])
}

/// پیام‌های فرم تماس صفحه‌ی اصلی
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// فرم‌های پرشدهٔ کوادکمپ — اسم، لینک پرتفولیو و رزومه.
///
/// رزومه دو راه داره و دقیقاً یکیش لازمه: یا فایلش رو آپلود می‌کنه که همین‌جا
/// توی دیتابیس می‌مونه، یا لینک گوگل درایوش رو می‌ده. آپلود سقف ۳ مگابایت
/// داره چون بدنهٔ درخواست روی ورسل از ۴٫۵ مگابایت بیشتر رد نمی‌شه.
model QuadcampApplication {
  id           String @id @default(cuid())
  fullName     String
  portfolioUrl String

  /// لینک رزومه روی گوگل درایو — اگه فایل آپلود کرده باشه خالیه
  resumeUrl String @default("")
  /// خودِ فایل رزومه. با select صریح خونده می‌شه تا توی فهرست پنل بار نشه.
  resumeData Bytes?
  resumeName String @default("")
  resumeMime String @default("")
  resumeSize Int    @default(0)

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// شماره‌هایی که برای اطلاع از تخفیف‌ها ثبت شدن
model DiscountSubscriber {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// کمپین فروش: بنر شمارش معکوس بالای صفحهٔ اصلی و قیمت کمپینیِ دوره‌ها.
/// قبل از startsAt بنر تا شروع می‌شمره، بین startsAt و endsAt تا پایان،
/// و فقط در همین بازه قیمت‌های prices روی سایت می‌شینن.
model Campaign {
  id        String   @id @default(cuid())
  title     String
  subtitle  String   @default("")
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  /// شناسهٔ دوره در mock-data → قیمت کمپین به تومان، مثل { "ui-offline": 5000000 }
  prices    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, startsAt])
}

/// دانشجوهای دوره‌های آفلاین و پروژه‌ای که برداشتن.
/// فعلاً بدون حساب کاربری ثبت می‌شن (ایمیل‌ها هنوز نیست)؛ بعداً با
/// افزودن userId به User وصل می‌شن و خود دانشجو موضوعش رو وارد می‌کنه.
/// فهرست موضوع‌های پیشنهادی که هنرجو توی فرم از بینشون انتخاب می‌کنه.
/// از شیت «موضوعات پیشنهادی» ورودی تیر ۱۴۰۵ وارد شده.
model ProjectTopic {
  id          String       @id @default(cuid())
  track       ProjectTrack
  title       String
  /// دسته مثل «فروشگاهی» یا «سلامت و تندرستی» — برای گروه‌بندی در فهرست
  category    String       @default("")
  /// فقط دورهٔ رابط: وبسایت یا اپلیکیشن
  platform    String       @default("")
  /// ساده، متوسط، سخت
  difficulty  String       @default("")
  /// چیزی که باید تحویل بده، یا خلاصهٔ ایده
  detail      String       @default("")
  /// ستارهٔ «پیشنهادی» در شیت
  recommended Boolean      @default(false)
  /// خاموش کردن بدون حذف، تا موضوعِ انتخاب‌شده‌ی کسی بی‌معنی نشه
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([track, active])
  @@index([category])
}

model StudentProject {
  id           String       @id @default(cuid())
  studentName  String
  track        ProjectTrack
  /// ماه ثبت‌نام به شکل «۱۴۰۵-۰۴» تا مرتب‌سازی و گروه‌بندی درست کار کنه
  intakeMonth  String
  /// موضوع پروژه — تا وقتی دانشجو انتخاب نکرده خالیه
  topic        String       @default("")
  /// لینک فایل کار، معمولاً فیگما. خودِ دانشجو توی فرم عمومی می‌ذارتش
  fileLink     String       @default("")
  /// شمارهٔ تسک‌هایی که منتور **بررسی‌شون کرده**.
  /// تیک یعنی بررسی شد، نه اینکه دانشجو تحویل داده.
  reviewedTasks Int[]       @default([])
  /// سابقه و آشنایی قبلی — از معرفی خودش توی گروه
  background   String?
  /// هدفش از دوره، برای اینکه منتور بدونه چه جور پروژه‌ای بهش بده
  goal         StudentGoal  @default(UNKNOWN)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([intakeMonth])
  @@index([track])
  @@index([goal])
}

enum ProjectTrack {
  UI
  UX
  QC // کوادکمپ — بوت‌کمپ پنج‌ماهه، تابستان ۱۴۰۴
}

enum StudentGoal {
  UNKNOWN // هنوز نگفته
  LEARNING // یادگیری و ارتقای سطح
  EMPLOYMENT // استخدام
  FREELANCE // کار فریلنسری
  BOTH // هم استخدام هم فریلنس
}

enum CertTrack {
  UI
  UX
  QC // کوادکمپ
  MENTOR // منتورهای مدرسه — سند جدا از دانشجوها، بدون سال و ترم
  RT // ROBOTYPE — دورهٔ ویدیویی هفت‌فصلی، بدون سال و ترم
}

enum Role {
  USER
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PurchaseStatus {
  PENDING
  SUCCESS
  FAILED
}

/// ترجیح پروژهٔ تکی یا گروهی. فرم عمومیه (/teamup/ui و /teamup/ux) و
/// خروجی اکسلش از پنل گرفته می‌شه. اگه تکی باشه فقط اسم و راه تماس پر می‌شه.
model TeamupPreference {
  id           String   @id @default(cuid())
  /// UI یا UX
  track        String
  fullName     String
  /// موبایل یا آیدی تلگرام. هر نفر در هر مسیر یک ردیف دارد و پر کردن دوباره جایگزینش می‌شه.
  contact      String
  /// SOLO یا GROUP
  mode         String
  /// کلید منطقه از lib/teamup.ts (فقط گروهی)
  region       String   @default("")
  city         String   @default("")
  /// کلیدهای MORNING / NOON / EVENING
  timeSlots    String[] @default([])
  level        Int?
  /// ابزار (UI) یا روش‌های پژوهش (UX) که بلده
  skills       String[] @default([])
  hoursPerWeek String   @default("")
  teamSize     String   @default("")
  goal         String   @default("")
  partnerName  String   @default("")
  note         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([track, contact])
  @@index([track, mode])
}
